# ==================== 应用配置 ====================
APP_NAME=AgenticWorker
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# ==================== 服务端口 ====================
WORKER_HOST=0.0.0.0
WORKER_PORT=8001

# ==================== 数据库配置 ====================
# PostgreSQL (生产环境推荐)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentic_db

# SQLite (开发环境)
# DATABASE_URL=sqlite+aiosqlite:///./agentic.db

# 连接池配置
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Session 配置
SESSION_EXPIRE_SECONDS=86400  # 24小时

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24小时

# ==================== WebSocket 配置 ====================
WS_HEARTBEAT_INTERVAL=30  # 心跳间隔（秒）
WS_HEARTBEAT_TIMEOUT=90   # 心跳超时（秒）
WS_MAX_CONNECTIONS=1000   # 最大连接数
WS_MESSAGE_QUEUE_SIZE=100 # 消息队列大小

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ==================== 外部服务配置 ====================
# TTS 服务
TTS_BASE_URL=https://tts-api.example.com/v1/synthesize
TTS_APP_ID=your-tts-app-id
TTS_ACCESS_KEY=your-tts-access-key
TTS_RESOURCE_ID=your-tts-resource-id
TTS_SPEAKER=default_speaker
TTS_TIMEOUT=30

# ASR 服务
ASR_APP_ID=4f95e97b0ec641fab9772b68a81bcf4a
ASR_TIMEOUT=30

# IoT 平台
IOT_BASE_URL_TEST=http://api-test.myroki.com/rest
IOT_BASE_URL_PROD=http://api.myroki.com/rest
IOT_TIMEOUT=30
IOT_CACHE_TTL=60  # 设备状态缓存时间（秒）

# ==================== 任务队列配置 ====================
TASK_QUEUE_MAX_SIZE=1000
TASK_WORKER_COUNT=4
TASK_TIMEOUT=300  # 任务超时（秒）

# ==================== 监控配置 ====================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================== 日志配置 ====================
LOG_FORMAT=json  # json 或 text
LOG_FILE_PATH=./logs/worker.log
LOG_FILE_MAX_BYTES=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5

# ==================== 性能配置 ====================
# Gunicorn Workers
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# ==================== 安全配置 ====================
# 允许的 WebSocket Origin
ALLOWED_WS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ==================== 开发配置 ====================
# 开发模式下的特殊配置
DEV_MOCK_EXTERNAL_SERVICES=false
DEV_SKIP_AUTH=false
